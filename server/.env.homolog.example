# =======================================================
# MSPLAY — CONFIGURAÇÃO DE AMBIENTE DE HOMOLOGAÇÃO
# =======================================================

NODE_ENV=homologation
PORT=3001
HOST=0.0.0.0

DB_PROVIDER=postgres
DATABASE_URL=postgresql://msplay_homolog:homolog_pass@localhost:5432/msplay_homolog_db

SESSION_SECRET=homolog_session_key_secret_min_32_characters_random
PROVIDER_CREDENTIALS_KEY=homolog_provider_encryption_key_32_chars

ADMIN_ORIGIN=https://painel-homolog.theussobral.shop

ENABLE_REAL_CONTENT_PROVIDER=false
RUN_REAL_PROVIDER_TESTS=false
PASSWORD_HASH_ITERATIONS=250000
